generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROVIDER
  PATIENT
  ADMIN
}

enum AppointmentStatus {
  LOCKED
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

model User {
  id                    String                @id @default(uuid()) @db.Uuid
  email                 String                @unique
  passwordHash          String?
  name                  String?
  phone                 String?
  role                  Role
  profiles              Profile[]
  availabilityRules     AvailabilityRule[]
  patientAppointments   Appointment[]         @relation("PatientAppointments")
  providerAppointments  Appointment[]         @relation("ProviderAppointments")
  services              Service[]
  patientPrescriptions  MedicalPrescription[] @relation("PatientPrescriptions")
  providerPrescriptions MedicalPrescription[] @relation("ProviderPrescriptions")
  payments              Payment[]
  patientPayments       Payment[]             @relation("PatientPayments")
  
  // New Relations for Patient tracking
  patientFiles          PatientFile[]         @relation("PatientFiles")
  patientFormularies    Formulary[]           @relation("PatientFormularies")
}

model Profile {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug      String  @unique
  fullName  String
  specialty String
  sisId     String?
  bio       String?
  
  // New Fields for Configurations/Vitrina
  searchSettings Json?   // Stores object like { "allowSEO": true, "tags": [...] }
  analytics      Json?   // Stores object like { "googleAnalyticsId": "G-...", "pixel": "..." }
}

model AvailabilityRule {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @db.Uuid
  provider   User     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0-6
  startTime  DateTime @db.Time
  endTime    DateTime @db.Time
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  providerId     String            @db.Uuid
  provider       User              @relation("ProviderAppointments", fields: [providerId], references: [id], onDelete: Restrict)
  patientId      String            @db.Uuid
  patient        User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Restrict)
  serviceId      String?           @db.Uuid
  service        Service?          @relation(fields: [serviceId], references: [id])
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus
  paymentId      String?
  clinicalRecord ClinicalRecord?
  payment        Payment?
}

model ClinicalRecord {
  id            String      @id @default(uuid()) @db.Uuid
  appointmentId String      @unique @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  content       String?
  createdAt     DateTime    @default(now())
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @db.Uuid
  action    String
  targetId  String   @db.Uuid
  timestamp DateTime @default(now())
}

model Service {
  id               String        @id @default(uuid()) @db.Uuid
  providerId       String        @db.Uuid
  provider         User          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name             String
  durationMin      Int
  price            Float
  isPublic         Boolean       @default(true)
  type             String // "ONLINE" | "IN_PERSON"
  requiresBoleta   Boolean
  appointments     Appointment[]
  
  // New Fields for Configurations/Comunicaciones
  locationDetails  String?
  billingDetails   String?
  remindersEnabled Boolean       @default(true)
  reminderChannels String[]      // e.g. ["WHATSAPP", "EMAIL"]
}

model MedicalPrescription {
  id         String   @id @default(uuid()) @db.Uuid
  displayId  Int      @default(autoincrement())
  patientId  String   @db.Uuid
  patient    User     @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Restrict)
  providerId String   @db.Uuid
  provider   User     @relation("ProviderPrescriptions", fields: [providerId], references: [id], onDelete: Restrict)
  type       String // "SIMPLE" | "RETAINED" | "EXAM" | "CERTIFICATE" | "MAGISTRAL"
  content    String // Usually encrypted string for Law 19.628
  status     String // "ACTIVE" | "ARCHIVED" | "VIGENTE"
  issuedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Payment {
  id             String       @id @default(uuid()) @db.Uuid
  providerId     String       @db.Uuid
  provider       User         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  patientId      String       @db.Uuid
  patient        User         @relation("PatientPayments", fields: [patientId], references: [id], onDelete: Restrict)
  appointmentId  String?      @unique @db.Uuid
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  amount         Float
  status         String       // "PENDING", "PAID", "DEPOSITED"
  boletaEmitted  Boolean      @default(false)
  boletaNumber   String?
  depositDate    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @db.Uuid
  patientId  String   @db.Uuid
  rating     Int // 1-5
  comment    String?
  createdAt  DateTime @default(now())
}

model Connection {
  id         String  @id @default(uuid()) @db.Uuid
  providerId String  @db.Uuid
  provider   String // "GOOGLE_CALENDAR" | "FONASA" | "SII"
  tokenData  Json?
  isActive   Boolean @default(false)
}

model BankDetails {
  id            String  @id @default(uuid()) @db.Uuid
  providerId    String  @unique @db.Uuid
  bankName      String
  accountType   String
  accountNumber String
  rut           String
  fullName      String
  email         String
}

model DigitalProduct {
  id          String  @id @default(uuid()) @db.Uuid
  providerId  String  @db.Uuid
  title       String
  description String
  price       Float
  fileUrl     String?
}

model PatientFile {
  id         String   @id @default(uuid()) @db.Uuid
  patientId  String   @db.Uuid
  patient    User     @relation("PatientFiles", fields: [patientId], references: [id], onDelete: Cascade)
  providerId String   @db.Uuid
  fileName   String
  fileUrl    String
  fileType   String
  sizeBytes  Int
  uploadedAt DateTime @default(now())
}

model Formulary {
  id         String   @id @default(uuid()) @db.Uuid
  patientId  String   @db.Uuid
  patient    User     @relation("PatientFormularies", fields: [patientId], references: [id], onDelete: Cascade)
  providerId String   @db.Uuid
  title      String
  content    Json
  filledAt   DateTime @default(now())
}
